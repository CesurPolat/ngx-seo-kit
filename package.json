{
  "name": "ngx-seo-kit",
  "version": "0.1.2",
  "description": "Build-time SEO tools for Angular applications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ngx-seo-kit": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/sitemap.test.js",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "angular",
    "seo",
    "sitemap",
    "sitemap.xml",
    "ngx"
  ],
  "dependencies": {
    "@inquirer/confirm": "^5.1.21",
    "@inquirer/input": "^4.3.1",
    "@inquirer/select": "^4.4.2"
  }
}
